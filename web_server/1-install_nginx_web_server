#!/usr/bin/env bash
# Script that configures a new Ubuntu machine with nginx

# Update package list
apt-get update -y

# Install nginx
apt-get install nginx -y

# Create a simple HTML page with "Holberton School"
echo "Holberton School for the win!" > /var/www/html/index.nginx-debian.html

# Ensure nginx is configured to listen on port 80 (default config should work)
# Start nginx without using systemctl
service nginx start

# Restart nginx to apply changes (without using systemctl)
service nginx restart

