#!/usr/bin/env bash
# Script that configures Nginx with a custom 404 page

# Update package list
apt-get update -y

# Install nginx
apt-get install nginx -y

# Create the index page with required content
echo "Holberton School" > /var/www/html/index.html

# Create custom 404 page
echo "Ceci n'est pas une page" > /var/www/html/404.html

# Add redirect rule to nginx config
sed -i '/server_name _;/a \\n\trewrite ^/redirect_me https://www.youtube.com/watch?v=QH2-TGUlwu4 permanent;' /etc/nginx/sites-available/default

# Add custom 404 error page configuration
sed -i '/server_name _;/a \\n\terror_page 404 /404.html;\n\tlocation = /404.html {\n\t\tinternal;\n\t}' /etc/nginx/sites-available/default

# Restart nginx service (without systemctl)
service nginx restart
